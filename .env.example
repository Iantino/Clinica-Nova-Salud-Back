# API
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=clinica_nova_salud

# Genera una clave distinta para cada entorno
SESSION_SECRET=replace-with-a-long-random-secret

# Correo de producción por API HTTPS (requerido en Railway Free/Trial/Hobby)
RESEND_API_KEY=
RESEND_FROM="Clínica NovaSalud <no-reply@tu-dominio-verificado.com>"

# SMTP solo para desarrollo local (usa contraseña de aplicación, no la normal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Debe ser la misma dirección que SMTP_USER
SMTP_FROM=
